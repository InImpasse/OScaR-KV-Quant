# Local context and weights (do not commit)
PROJECT_CONTEXT.md
checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
.venv-*/
venv/
*.egg-info/
.eggs/
dist/
build/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.deb

# Benchmark outputs
results/
runs/
.cache/
*.log

# Local eval run artifacts. Keep source wrappers, docs, and curated summary
# files tracked; ignore per-run logs/reports/metrics generated by benchmarks.
rotation/**/eval_*/
rotation/**/eval-*/
rotation/**/accuracy_suite_*/
rotation/**/accuracy_suite-*/

# Calibration/runtime dumps generated by OSCAR rotation jobs.
rotation/**/qkv_dumps/
rotation/**/rotations/
!rotation/granite-4.0-1b/**/rotations/
!rotation/granite-4.0-1b/**/rotations/**
rotation/**/*.safetensors

# Optional external eval harness checkouts.
third_party/LiveCodeBench/
third_party/human-eval/

# Third-party build artifacts (submodule may generate)
third_party/OSCAR/**/*.so
third_party/OSCAR/**/build/
